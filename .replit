modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 22306
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CARTESIA_VOICE_ID = "791d5162-d5eb-40f0-8189-f19db44611d8"
BASE_PATH = "/"
GMAIL_USER = "dtc1752@gmail.com"
