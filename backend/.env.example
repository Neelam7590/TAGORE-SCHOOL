# Server
PORT=8080

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — set to your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# Gmail (for contact form & admission emails)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# OpenAI / Groq API key (for AI chat — Groq keys start with gsk_)
OPENAI_API_KEY=gsk_...

# Cartesia TTS (optional — for voice in chatbot)
CARTESIA_API_KEY=sk_car_...
CARTESIA_VOICE_ID=your-voice-id
